# FalaComigo - backend local Windows
# Copie APENAS se for configurar uma instalacao nova.
# Nao substitua o server/.env que ja funciona: preserve as chaves reais.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# MySQL local. Se a senha contiver @, substitua-o por %40 na URL.
DATABASE_URL="mysql://USUARIO:SENHA@127.0.0.1:3306/converso_local"

# Preserve os valores existentes da instalacao funcionando.
JWT_SECRET=INSIRA_A_CHAVE_JWT_EXISTENTE
JWT_EXPIRES_IN=12h
INTEGRATION_ENCRYPTION_KEY=INSIRA_A_CHAVE_ATUAL_SEM_TROCAR

ALLOW_REGISTRATION=true
EVOLUTION_ALLOW_LOCAL_HTTP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EVOLUTION_AUTO_WEBHOOK=true
# Endereco que o container Evolution realmente consegue acessar no seu ambiente.
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:4000
EVOLUTION_WEBHOOK_SECRET=INSIRA_O_SEGREDO_ATUAL

# Caminho do NAS no Windows (UNC); mantenha o valor atual se ja funciona.
# FALACOMIGO_STORAGE_PATH=\\SERVIDOR\Compartilhamento\Falacomigo

# Se houver mais de uma organizacao ativa, configure o ID publico tecnico.
# PUBLIC_TECHNICAL_ORG_ID=
# FALACOMIGO_TECNICO_PATH=
